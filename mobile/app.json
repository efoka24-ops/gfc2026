{
  "expo": {
    "name": "GFC Championnat",
    "slug": "gfc-championship",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.gfc.championship",
      "versionCode": 1
    },
    "ios": {
      "bundleIdentifier": "com.gfc.championship"
    },
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ]
  }
}
