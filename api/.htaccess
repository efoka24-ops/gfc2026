<IfModule mod_rewrite.c>
    RewriteEngine On

    # Recuperer l en-tete Authorization : certains hebergements CGI/FastCGI le
    # suppriment, ce qui rend l API "non authentifiee" meme avec un jeton valide.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Securite : bloquer l acces direct aux fichiers et dossiers internes.
    RewriteRule ^(\.env|artisan|composer\.(json|lock)|setup-web\.php|deploy-webhook\.php)$ - [F,L]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|tests|vendor)(/|$) - [F,L]

    # Renvoi Laravel habituel
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>
