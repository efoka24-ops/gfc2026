# Identifiants de deploiement — copier en deploy/.env.deploy (ignore par git)
# et ne JAMAIS commiter le fichier resultant.
#
#   cp deploy/.env.deploy.example deploy/.env.deploy
#   set -a && . deploy/.env.deploy && set +a
#   bash deploy/deploy-ftp.sh --dry-run

